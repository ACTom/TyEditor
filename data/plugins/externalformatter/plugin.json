{
  "schema": 1,
  "api": 1,
  "id": "sample.externalformatter",
  "name": "External Formatter",
  "version": "1.0.0",
  "description": "Run clang-format on the current selection or document.",
  "default_locale": "en",
  "runtime": {
    "type": "process",
    "command": [
      "python3",
      "${pluginDir}/plugin.py"
    ]
  },
  "timeout_ms": 10000,
  "compatibility": {
    "platforms": [
      "any"
    ]
  },
  "permissions": [
    "text.read",
    "text.write",
    "process.spawn"
  ],
  "commands": [
    {
      "id": "selection",
      "title": "Format Selection with clang-format",
      "scope": "selection"
    },
    {
      "id": "document",
      "title": "Format Document with clang-format",
      "scope": "document"
    }
  ],
  "options": []
}
